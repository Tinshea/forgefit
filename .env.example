# Copy to .env and adjust. docker-compose reads .env automatically.

POSTGRES_USER=forgefit
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=forgefit

NODE_ENV=production
API_PORT=3000
WEB_PORT=8080

# HMAC-SHA256 shared secret for signed inbound webhooks (X-ForgeFit-Signature).
WEBHOOK_SECRET=dev-secret-change-me

# Origines navigateur autorisées (séparées par des virgules).
# Inclure le port du serveur de dev Vite (5173) : même derrière son
# proxy, le navigateur envoie `Origin` sur toutes les écritures.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Baked into the frontend bundle at build time.
VITE_API_BASE=http://localhost:3000

# External shared network for the wider data pipeline.
# Create it first: docker network create forgefit-mesh
MESH_NETWORK=forgefit-mesh
